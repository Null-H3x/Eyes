+                if any(k in low for k in keys):
+                    hits.append(line.rstrip())
+        if hits:
+            for h in hits[-15:]:
+                print("    " + h)
+        else:
+            print("    (no error/skip/done markers found)")
+    except OSError as e:
+        print(f"    could not read log: {e}")
