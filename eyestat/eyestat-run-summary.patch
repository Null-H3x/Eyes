     finally:
         if monitor is not None:
             monitor.stop()
@@ -1052,6 +1078,24 @@ def main():
     # Optional: merge shards into final ranked file
     merge_results(args.output_dir, args.threshold)
 
+    # Always-on readable run summary — the file you review whether or not
